{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenConvert",
  "version": "1.0.0",
  "identifier": "site.alexyalex.openconvert",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OpenConvert",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.svg"
    ],
    "resources": [
      "binaries/**/*"
    ],
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "copyright": "MIT License",
    "category": "Utility",
    "shortDescription": "100% Local, Open Source File Converter",
    "longDescription": "OpenConvert is a privacy-first, offline file converter supporting images, video, audio, documents, ebooks, and archives.",
    "macOS": {
      "entitlements": null,
      "exceptionDomain": "",
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "dialog": true,
    "fs": {
      "all": true,
      "scope": ["$APPDATA/**", "$TEMP/**", "$DOWNLOAD/**"]
    }
  }
}